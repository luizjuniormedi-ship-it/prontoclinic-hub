# Pool comum
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=prontoclinic
PGUSER=app_prontomedic
PGPASSWORD=SET_IN_SECRET_MANAGER

# Pool interno exclusivo
LOCAL_AUTH_SERVICE_PGUSER=local_auth_service
LOCAL_AUTH_SERVICE_PGPASSWORD=SET_IN_SECRET_MANAGER
LOCAL_AUTH_SERVICE_POOL_MAX=3

# Chave opaca server-side; deve ser diferente de JWT_SECRET e nunca ir ao browser
LOCAL_AUTH_SERVICE_KEY=SET_IN_SECRET_MANAGER_MINIMUM_32_RANDOM_CHARS

# URLs aceitas pelo fluxo de convite/recuperacao
LOCAL_AUTH_PUBLIC_URL=https://prontomedic.example.com
LOCAL_AUTH_REDIRECT_ORIGINS=https://prontomedic.example.com

# Entrega server-side. Use smtp OU webhook; nunca inclua segredos no frontend.
LOCAL_AUTH_MAIL_PROVIDER=smtp
LOCAL_AUTH_SMTP_HOST=smtp.example.com
LOCAL_AUTH_SMTP_PORT=587
LOCAL_AUTH_SMTP_SECURE=false
LOCAL_AUTH_SMTP_USERNAME=SET_IN_SECRET_MANAGER
LOCAL_AUTH_SMTP_PASSWORD=SET_IN_SECRET_MANAGER
LOCAL_AUTH_MAIL_FROM=no-reply@example.com
