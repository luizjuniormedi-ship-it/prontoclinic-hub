# Paths and names are explicit so the helper can fail closed on topology drift.
PRONTOMEDIC_AUTH_ROOT=/opt/prontomedic/auth-runtime
PRONTOMEDIC_AUTH_ENV_FILE=/opt/prontomedic/auth-runtime/secrets/.env.auth
PRONTOMEDIC_EDGE_ENV_FILE=/opt/prontomedic/edge-runtime/secrets/.env.functions
PRONTOMEDIC_BACKUP_ROOT=/var/backups/prontomedic/auth-admin
PRONTOMEDIC_EDGE_HELPER=/usr/local/sbin/prontomedic-edge-deploy
PRONTOMEDIC_EDGE_SMOKE_BASE_URL=http://127.0.0.1:9000
PRONTOMEDIC_AUTH_PM2_PROCESS=prontomedic-auth
PRONTOMEDIC_DATABASE=prontoclinic
PRONTOMEDIC_AUTH_HEALTH_URL=http://127.0.0.1:8000/health
